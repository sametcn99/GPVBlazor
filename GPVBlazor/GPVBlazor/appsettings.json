{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GitHub": {
    "ClientId": "YOUR_CLIENT_ID",
    "ClientSecret": "YOUR_CLIENT_SECRET",
    "RedirectUri": "https://localhost:5295/api/auth/github-callback"
  },
  "AuthSecurity": {
    "AuthCookieName": "gpv.auth",
    "AuthCookieSameSite": "Lax",
    "AuthCookieSecurePolicy": "SameAsRequest",
    "AntiforgeryCookieName": "gpv.af",
    "AntiforgeryHeaderName": "X-CSRF-TOKEN",
    "AntiforgeryRequestTokenCookieName": "gpv.csrf",
    "AntiforgeryCookieSameSite": "Strict",
    "AntiforgeryRequestTokenCookieSameSite": "Strict",
    "AntiforgeryCookieSecurePolicy": "SameAsRequest",
    "OAuthStateCookieName": "gpv.oauth.state",
    "OAuthStateCookieSameSite": "Lax",
    "OAuthStateCookieSecurePolicy": "SameAsRequest",
    "OAuthStateTtlMinutes": 10
  }
}
