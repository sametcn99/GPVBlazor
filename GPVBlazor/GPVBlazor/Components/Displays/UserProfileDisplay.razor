@rendermode InteractiveServer
@using GPVBlazor.Models
@inject Services.Interfaces.IContactService ContactService
@inject Services.Interfaces.INetworkAnalysisService NetworkAnalysisService
@inject Services.Interfaces.IUserService UserService

@if (UserProfile is null) { return; }
<div class="profile-hero-card box mb-5">
    <div class="profile-header">
        <div class="profile-avatar-section">
            <figure class="profile-avatar">
                <img src="@UserProfile.AvatarUrl" alt="@UserProfile.Name's avatar" />
                @if (UserProfile.Hireable == true)
                {
                    <span class="hireable-badge" title="Available for hire">
                        <i class="fas fa-briefcase"></i>
                    </span>
                }
            </figure>
            <div class="profile-quick-stats is-hidden-tablet">
                <div class="quick-stat">
                    <span class="stat-value">@UserProfile.PublicRepos</span>
                    <span class="stat-label">Repos</span>
                </div>
                <div class="quick-stat">
                    <span class="stat-value">@UserProfile.Followers</span>
                    <span class="stat-label">Followers</span>
                </div>
                <div class="quick-stat">
                    <span class="stat-value">@UserProfile.Following</span>
                    <span class="stat-label">Following</span>
                </div>
            </div>
        </div>

        <div class="profile-info">
            <div class="profile-name-section">
                <h1 class="profile-name">@(UserProfile.Name ?? UserProfile.Login)</h1>
                <a href="https://github.com/@UserProfile.Login" target="_blank" rel="noopener" class="profile-username">
                    <i class="fab fa-github"></i>
                    <span>@@@UserProfile.Login</span>
                    <i class="fas fa-external-link-alt fa-xs"></i>
                </a>
            </div>

            @if (!string.IsNullOrEmpty(UserProfile.Bio))
            {
                <p class="profile-bio">
                    <i class="fas fa-quote-left fa-sm"></i>
                    @UserProfile.Bio
                </p>
            }

            <div class="profile-details">
                @if (!string.IsNullOrEmpty(UserProfile.Company))
                {
                    <div class="profile-detail-item">
                        <i class="fas fa-building"></i>
                        <span>@UserProfile.Company</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(UserProfile.Location))
                {
                    <div class="profile-detail-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>@UserProfile.Location</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(UserProfile.Email))
                {
                    <div class="profile-detail-item">
                        <i class="fas fa-envelope"></i>
                        <a href="mailto:@UserProfile.Email">@UserProfile.Email</a>
                    </div>
                }
                @if (!string.IsNullOrEmpty(UserProfile.Blog))
                {
                    <div class="profile-detail-item">
                        <i class="fas fa-globe"></i>
                        <a href="@(UserProfile.Blog.StartsWith("http") ? UserProfile.Blog : $"https://{UserProfile.Blog}")" target="_blank" rel="noopener">
                            @TruncateUrl(UserProfile.Blog)
                        </a>
                    </div>
                }
                @if (!string.IsNullOrEmpty(UserProfile.TwitterUsername))
                {
                    <div class="profile-detail-item">
                        <i class="fab fa-twitter"></i>
                        <a href="https://twitter.com/@UserProfile.TwitterUsername" target="_blank" rel="noopener">@@@UserProfile.TwitterUsername</a>
                    </div>
                }
                @if (_socialAccounts is not null)
                {
                    @foreach (var account in _socialAccounts)
                    {
                        <div class="profile-detail-item">
                            <i class="@GetSocialIcon(account.Provider ?? "")"></i>
                            <a href="@account.Url" target="_blank" rel="noopener">@TruncateUrl(account.Url ?? "")</a>
                        </div>
                    }
                }
                <div class="profile-detail-item">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Joined @UserProfile.CreatedAt.ToString("MMMM yyyy")</span>
                </div>
                @if (_organizations is not null && _organizations.Any())
                {
                    <div class="profile-detail-item organizations-section">
                        <div class="organizations-list">
                            @foreach (var org in _organizations)
                            {
                                <a href="/p/@org.Login" class="organization-logo-btn" data-tooltip="@org.Login">
                                    <img src="@org.AvatarUrl" alt="@org.Login" />
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="profile-stats-section is-hidden-mobile">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-code-branch"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-number">@UserProfile.PublicRepos</span>
                    <span class="stat-text">Repositories</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-file-code"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-number">@UserProfile.PublicGists</span>
                    <span class="stat-text">Gists</span>
                </div>
            </div>
        </div>
    </div>

    <div class="profile-actions">
        <button class="profile-action-btn followers-btn" @onclick="FetchAndShowFollowersModal" disabled="@_isLoadingFollowers">
            @if (_isLoadingFollowers)
            {
                <i class="fas fa-spinner fa-pulse"></i>
                <span>Loading...</span>
            }
            else
            {
                <i class="fas fa-user-friends"></i>
                <span>Followers</span>
                <span class="action-count">@FormatCount(UserProfile.Followers)</span>
            }
        </button>
        <button class="profile-action-btn following-btn" @onclick="FetchAndShowFollowingModal" disabled="@_isLoadingFollowing">
            @if (_isLoadingFollowing)
            {
                <i class="fas fa-spinner fa-pulse"></i>
                <span>Loading...</span>
            }
            else
            {
                <i class="fas fa-users"></i>
                <span>Following</span>
                <span class="action-count">@FormatCount(UserProfile.Following)</span>
            }
        </button>
        <button class="profile-action-btn network-btn" @onclick="FetchAndShowNetworkAnalysisModal" disabled="@_isLoadingNetworkAnalysis">
            @if (_isLoadingNetworkAnalysis)
            {
                <i class="fas fa-spinner fa-pulse"></i>
                <span>Analyzing...</span>
            }
            else
            {
                <i class="fas fa-network-wired"></i>
                <span>Network Analyze</span>
            }
        </button>
        <a href="https://github.com/@UserProfile.Login" target="_blank" rel="noopener" class="profile-action-btn github-btn">
            <i class="fab fa-github"></i>
            <span>View on GitHub</span>
        </a>
    </div>
</div>


@if (_showFollowersModal)
{
    <ContactListModal ShowModal="_showFollowersModal" Users="_followers"
        ModalTitle="ContactListModal.ModalTitleEnum.Followers" OnClose="ToggleModal" />
}
@if (_showFollowingModal)
{
    <ContactListModal ShowModal="_showFollowingModal" Users="_followings"
        ModalTitle="ContactListModal.ModalTitleEnum.Following" OnClose="ToggleModal" />
}
@if (_showNetworkAnalysisModal)
{
    <NetworkAnalysisModal ShowModal="_showNetworkAnalysisModal" AnalysisResult="_networkAnalysisResult" OnClose="ToggleModal" />
}

@code {
    [Parameter] public User? UserProfile { get; set; }
    [Parameter] public string? Token { get; set; }

    private List<User>? _followers;
    private bool _showFollowersModal;
    private bool _isLoadingFollowers;

    private List<User>? _followings;
    private bool _showFollowingModal;
    private bool _isLoadingFollowing;

    private NetworkAnalysisResult? _networkAnalysisResult;
    private bool _showNetworkAnalysisModal;
    private bool _isLoadingNetworkAnalysis;

    private List<Organization>? _organizations;
    private List<SocialAccount>? _socialAccounts;

    protected override async Task OnParametersSetAsync()
    {
        if (UserProfile?.Login is not null && Token is not null)
        {
            var orgsTask = UserService.FetchUserOrganizations(UserProfile.Login, Token);
            var socialTask = UserService.FetchUserSocialAccounts(UserProfile.Login, Token);

            await Task.WhenAll(orgsTask, socialTask);

            _organizations = await orgsTask;
            _socialAccounts = await socialTask;
        }
    }

    private string GetSocialIcon(string provider)
    {
        return provider.ToLower() switch
        {
            "linkedin" => "fab fa-linkedin",
            "twitter" => "fab fa-twitter",
            "facebook" => "fab fa-facebook",
            "instagram" => "fab fa-instagram",
            "youtube" => "fab fa-youtube",
            "twitch" => "fab fa-twitch",
            "reddit" => "fab fa-reddit",
            "mastodon" => "fab fa-mastodon",
            "tiktok" => "fab fa-tiktok",
            "discord" => "fab fa-discord",
            "npm" => "fab fa-npm",
            _ => "fas fa-link"
        };
    }

    private string FormatCount(int count)
    {
        if (count >= 1000000)
            return $"{count / 1000000.0:F1}M";
        if (count >= 1000)
            return $"{count / 1000.0:F1}K";
        return count.ToString();
    }

    private string TruncateUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return url;
        var cleanUrl = url.Replace("https://", "").Replace("http://", "").TrimEnd('/');
        return cleanUrl.Length > 30 ? cleanUrl.Substring(0, 27) + "..." : cleanUrl;
    }

    private async Task FetchAndShowFollowersModal()
    {
        if (UserProfile?.Login is null) return;
        if (Token is null) return;

        _isLoadingFollowers = true;
        _followers = await ContactService.FetchModalData<User>(UserProfile.Login, "followers", Token);
        _isLoadingFollowers = false;

        ToggleModalVisibility(showFollowers: true);
    }

    private async Task FetchAndShowFollowingModal()
    {
        if (UserProfile?.Login is null) return;
        if (Token is null) return;

        _isLoadingFollowing = true;
        _followings = await ContactService.FetchModalData<User>(UserProfile.Login, "following", Token);
        _isLoadingFollowing = false;

        ToggleModalVisibility(showFollowing: true);
    }

    private async Task FetchAndShowNetworkAnalysisModal()
    {
        if (UserProfile?.Login is null) return;
        if (Token is null) return;

        _isLoadingNetworkAnalysis = true;

        var networkData = await ContactService.FetchNetworkData(UserProfile.Login, Token);
        _networkAnalysisResult = NetworkAnalysisService.BuildAnalysis(networkData.Followers, networkData.Following);

        _isLoadingNetworkAnalysis = false;
        ToggleModalVisibility(showNetworkAnalysis: true);
    }

    private void ToggleModalVisibility(bool showFollowers = false, bool showFollowing = false, bool showNetworkAnalysis = false)
    {
        _showFollowersModal = showFollowers;
        _showFollowingModal = showFollowing;
        _showNetworkAnalysisModal = showNetworkAnalysis;
    }

    private void ToggleModal()
    {
        _showFollowersModal = false;
        _showFollowingModal = false;
        _showNetworkAnalysisModal = false;
    }
}
