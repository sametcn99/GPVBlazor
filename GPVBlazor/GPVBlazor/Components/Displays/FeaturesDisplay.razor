            Color = "primary",
            Category = "Search"
        },
        new FeatureText
        {
            Icon = "fas fa-code-branch",
            Header = "Repository Explorer",
            Span = "Browse through all public repositories with detailed information including stars, forks, language, and descriptions. Filter and sort repositories by various criteria.",
            Color = "info",
            Category = "Repositories"
        },
        new FeatureText
        {
            Icon = "fas fa-chart-line",
            Header = "Star History Charts",
            Span = "Visualize the growth of repository stars over time with interactive charts. Understand how a project's popularity has evolved since its creation.",
            Color = "warning",
