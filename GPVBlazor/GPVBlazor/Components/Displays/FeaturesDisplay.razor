<section class="section" id="features">
    <div class="container">
        <div class="has-text-centered mb-6">
            <h2 class="title is-3 has-text-weight-bold">
                <span class="icon has-text-warning mr-2">
                    <i class="fas fa-star"></i>
                </span>
                Features
            </h2>
            <p class="subtitle is-5 has-text-grey" style="max-width: 600px; margin: 0 auto;">
                Comprehensive tools designed for developers to explore and analyze GitHub profiles efficiently
            </p>
        </div>
        <div class="columns is-multiline">
            @foreach (var feature in featureTexts)
            {
                <div class="column is-6-tablet is-4-desktop">
                    <div class="box" style="height: 100%;">
                        <div class="is-flex is-align-items-start mb-4">
                            <span class="icon is-medium has-text-@feature.Color mr-3" style="flex-shrink: 0;">
                                <i class="@feature.Icon fa-lg"></i>
                            </span>
                            <div>
                                <h3 class="title is-5 mb-1">@feature.Header</h3>
                                <span class="tag is-dark is-small">@feature.Category</span>
                            </div>
                        </div>
                        <div class="content">
                            <p class="has-text-grey-light is-size-6">@feature.Span</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private List<FeatureText> featureTexts = new List<FeatureText>
    {
        new FeatureText
        {
            Icon = "fas fa-search",
            Header = "User Search",
