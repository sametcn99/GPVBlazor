@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager NavManager
@inject Services.Interfaces.IAuthService AuthService
@inject IJSRuntime JS

<nav class="navbar" role="navigation" aria-label="main navigation">
    <div class="container">
        <div class="navbar-brand">
            <NavLink href="/" Match="NavLinkMatch.All" class="navbar-item pl-0">
                <div class="is-flex is-align-items-center">
                    <span class="icon is-large has-text-primary mr-2">
                        <i class="fab fa-github fa-2x"></i>
                    </span>
                    <div class="ml-1">
                        <p class="title is-6 mb-0 has-text-weight-bold has-text-white" style="letter-spacing: -0.5px;">GitHub Profile Viewer</p>
                        <p class="subtitle is-7 has-text-grey" style="margin-top: -3px; font-weight: 400;">Explore & Analyze</p>
                    </div>
                </div>
            </NavLink>

            <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="@isMenuActive.ToString()"
               @onclick="ToggleNavbar">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </a>
        </div>

        <div id="navbarMenu" class="@GetNavbarMenuClass()">
            <div class="navbar-end">
                        <GPVBlazor.Components.Displays.SearchBarDisplay IsNavbarMode="true" />
                        <div class="navbar-item">
                            @if (string.IsNullOrEmpty(AuthService.CurrentAccessToken))
                            {
                                @if (isSignInDropdownActive)
                                {
                                    <div class="dropdown-backdrop" @onclick="CloseSignInDropdown"></div>
                                }
                                <div class="dropdown is-right @(isSignInDropdownActive ? "is-active" : "")">
                                    <div class="dropdown-trigger">
                                        <button class="button is-primary is-outlined" @onclick="ToggleSignInDropdown" aria-haspopup="true" aria-controls="signin-dropdown-menu">
                                            <span class="icon">
                                                <i class="fab fa-github"></i>
                                            </span>
                                            <span>Sign In</span>
                                            <span class="icon is-small">
                                                <i class="fas fa-angle-down" aria-hidden="true"></i>
                                            </span>
                                        </button>
                                    </div>
                                    <div class="dropdown-menu" id="signin-dropdown-menu" role="menu">
                                        <div class="dropdown-content">
                                            <a href="@AuthService.GetGitHubLoginUrl()" class="dropdown-item">
                                                <span class="icon mr-2"><i class="fab fa-github"></i></span>
                                                Sign in with GitHub
                                            </a>
                                            <a class="dropdown-item" @onclick="OpenTokenLoginModal">
                                                <span class="icon mr-2"><i class="fas fa-key"></i></span>
                                                Sign in with Access Token
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (isUserMenuActive)
                                {
                                    <div class="dropdown-backdrop" @onclick="CloseUserMenu"></div>
                                }
                                <div class="dropdown is-right @(isUserMenuActive ? "is-active" : "")">
                                    <div class="dropdown-trigger">
                                        <button class="button is-white" @onclick="ToggleUserMenu" aria-haspopup="true" aria-controls="dropdown-menu">
                                            <figure class="image is-24x24 mr-2">
                                                <img class="is-rounded" src="@(AuthService.CurrentUser?.AvatarUrl ?? "https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png")" alt="Avatar">
                                            </figure>
                                            <span>@(AuthService.CurrentUser?.Login ?? "User")</span>
                                            <span class="icon is-small">
                                                <i class="fas fa-angle-down" aria-hidden="true"></i>
                                            </span>
                                        </button>
                                    </div>
                                    <div class="dropdown-menu" id="dropdown-menu" role="menu">
                                        <div class="dropdown-content">
                                            <a href="/p/@(AuthService.CurrentUser?.Login)" class="dropdown-item" @onclick="CloseUserMenu">
                                                <span class="icon mr-2"><i class="fas fa-user"></i></span>
                                                Profile
                                            </a>
                                            <a class="dropdown-item" @onclick="OpenApiLimitsModal">
                                                <span class="icon mr-2"><i class="fas fa-tachometer-alt"></i></span>
                                                API Limits
                                            </a>
                                            <hr class="dropdown-divider">
                                            <a class="dropdown-item has-text-danger" @onclick="SignOut">
                                                <span class="icon mr-2"><i class="fas fa-sign-out-alt"></i></span>
                                                Sign Out
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
        
        <GPVBlazor.Components.Displays.ApiLimitsModal @bind-IsActive="isApiLimitsModalActive" />
        <GPVBlazor.Components.Displays.LoginWithTokenModal @bind-IsActive="isTokenLoginModalActive" />
        
        @code {
            private bool isMenuActive = false;
            private bool isUserMenuActive = false;
            private bool isApiLimitsModalActive = false;
            private bool isSignInDropdownActive = false;
            private bool isTokenLoginModalActive = false;
        
            private void ToggleNavbar() => isMenuActive = !isMenuActive;
            private void ToggleUserMenu() => isUserMenuActive = !isUserMenuActive;
            private void CloseUserMenu() => isUserMenuActive = false;
            
            private void ToggleSignInDropdown() => isSignInDropdownActive = !isSignInDropdownActive;
            private void CloseSignInDropdown() => isSignInDropdownActive = false;

            private void OpenTokenLoginModal()
            {
                isTokenLoginModalActive = true;
                isSignInDropdownActive = false;
            }

            private void OpenApiLimitsModal()
            {
                isApiLimitsModalActive = true;
                isUserMenuActive = false;
            }
        
            private string GetNavbarMenuClass() { return "navbar-menu" + (isMenuActive ? " is-active" : ""); }
        
            protected override void OnInitialized()
            {
                AuthService.OnAuthStateChanged += StateHasChanged;
            }
        
            protected override async Task OnAfterRenderAsync(bool firstRender)
            {
                if (firstRender)
                {
                    var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
                    if (!string.IsNullOrEmpty(token))
                    {
                        AuthService.Login(token);
                        StateHasChanged();
                    }
                }
            }
        
            public void Dispose()
            {
                AuthService.OnAuthStateChanged -= StateHasChanged;
            }
        
            private async Task SignOut()
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
                await JS.InvokeVoidAsync("localStorage.removeItem", "authSource");
                AuthService.Logout();
                NavManager.NavigateTo("/", false);
            }
        }
        
        <style>
            .dropdown-backdrop {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                z-index: 998;
                cursor: default;
            }
            
            .dropdown.is-active {
                z-index: 999;
            }
        </style>