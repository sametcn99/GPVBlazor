@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager NavManager
@inject Services.Interfaces.IAuthService AuthService
@inject IJSRuntime JS

<nav class="navbar" role="navigation" aria-label="main navigation">
    <div class="container">
        <div class="navbar-brand">
            <NavLink href="/" Match="NavLinkMatch.All" class="navbar-item pl-0">
                <div class="is-flex is-align-items-center">
                    <span class="icon is-large has-text-primary mr-2">
                        <i class="fab fa-github fa-2x"></i>
                    </span>
                    <div class="ml-1">
                        <p class="title is-6 mb-0 has-text-weight-bold has-text-white" style="letter-spacing: -0.5px;">GitHub Profile Viewer</p>
                        <p class="subtitle is-7 has-text-grey" style="margin-top: -3px; font-weight: 400;">Explore & Analyze</p>
                    </div>
                </div>
            </NavLink>

            <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="@isMenuActive.ToString()"
               @onclick="ToggleNavbar">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </a>
        </div>

        <div id="navbarMenu" class="@GetNavbarMenuClass()">
            <div class="navbar-start ml-4-desktop">
                <NavLink href="/" Match="NavLinkMatch.All" class="navbar-item">
                    <span class="icon is-small mr-2"><i class="fas fa-home"></i></span>
                    <span>Home</span>
                </NavLink>
                <a href="/#features" class="navbar-item">
                    <span class="icon is-small mr-2"><i class="fas fa-star"></i></span>
                    <span>Features</span>
                </a>
            </div>

            <div class="navbar-end">
                <GPVBlazor.Components.Displays.SearchBarDisplay IsNavbarMode="true" />
                <div class="navbar-item">
                    @if (string.IsNullOrEmpty(AuthService.CurrentAccessToken))
                    {
                        <a href="@AuthService.GetGitHubLoginUrl()" class="button is-primary is-outlined">
                            <span class="icon">
                                <i class="fab fa-github"></i>
                            </span>
                            <span>Sign In</span>
                        </a>
                    }
                    else
                    {
                        <button class="button is-danger is-light" @onclick="SignOut">
                            <span class="icon">
                                <i class="fas fa-sign-out-alt"></i>
                            </span>
                            <span>Sign Out</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</nav>

@code {
    private bool isMenuActive = false;
    private void ToggleNavbar() => isMenuActive = !isMenuActive;
    private string GetNavbarMenuClass() { return "navbar-menu" + (isMenuActive ? " is-active" : ""); }

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                AuthService.Login(token);
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }

    private async Task SignOut()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "authSource");
        AuthService.Logout();
        NavManager.NavigateTo("/", false);
    }
}