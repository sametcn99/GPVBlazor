@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IJSRuntime JS
@inject Services.Interfaces.IAuthService AuthService
@inject NavigationManager NavManager
<PageTitle>GitHub Profile Viewer - Explore GitHub Profiles</PageTitle>

<!-- Hero Section -->
<section class="hero is-medium" style="background: linear-gradient(180deg, rgba(102, 126, 234, 0.1) 0%, transparent 100%);">
    <div class="hero-body">
        <div class="container has-text-centered">
            <div class="mb-5">
                <span class="icon is-large has-text-primary" style="font-size: 4rem;">
                    <i class="fab fa-github"></i>
                </span>
            </div>
            <h1 class="title is-1 is-size-2-mobile has-text-weight-bold mb-4">
                GitHub Profile Viewer
            </h1>
            <p class="subtitle is-4 is-size-5-mobile has-text-grey-light mb-2" style="max-width: 700px; margin: 0 auto;">
                A comprehensive tool for exploring GitHub profiles, repositories, and developer statistics
            </p>
            <p class="is-size-6 has-text-grey mb-5" style="max-width: 600px; margin: 0 auto;">
                Search for any GitHub user to view their profile details, repository information, 
                star history, gists, and network connections — all in one place.
            </p>
            <div class="buttons is-centered mt-5">
                <GPVBlazor.Components.Displays.SearchBarDisplay />
            </div>
        </div>
    </div>
</section>

<!-- Main Content Grid -->
<section class="section">
    <div class="container">
        <div class="columns is-multiline">
            <!-- Auth Token Section -->
            <div class="column is-6">
                <div class="box" style="height: 100%;">
                    <div class="is-flex is-align-items-center mb-4">
                        <span class="icon is-medium has-text-warning mr-3">
                            <i class="fas fa-key fa-lg"></i>
                        </span>
                        <div>
                            <h2 class="title is-5 mb-0">Authentication Status</h2>
                            <p class="is-size-7 has-text-grey">Manage your access level</p>
                        </div>
                    </div>
                    <div class="content">
                        @if (string.IsNullOrEmpty(AuthService.CurrentAccessToken))
                        {
                            <p class="is-size-6 has-text-grey-light mb-4">
                                Add your GitHub personal access token to unlock higher API rate limits 
                                and access private repository information.
                            </p>
                            
                            <div class="field mb-4">
                                <button class="button is-dark is-fullwidth" @onclick="SignInWithGitHub">
                                    <span class="icon">
                                        <i class="fab fa-github"></i>
                                    </span>
                                    <span>Sign in with GitHub</span>
                                </button>
                            </div>

                            <div class="is-divider" data-content="OR"></div>
                            <p class="has-text-centered is-size-7 has-text-grey mb-3">- OR -</p>

                            <div class="field">
                                <label class="label is-small has-text-grey-light">Personal Access Token</label>
                                <div class="control has-icons-left">
                                    <input @bind="AuthToken" placeholder="ghp_xxxxxxxxxxxx" class="input"
                                        type="password" @oninput="HandleInputChange" />
                                    <span class="icon is-small is-left">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                </div>
                            </div>
                            <div class="field">
                                <div class="control">
                                    <button class="button is-primary is-fullwidth" @onclick="AddToken">
                                        <span class="icon">
                                            <i class="fas fa-plus-circle"></i>
                                        </span>
                                        <span>Save Token</span>
                                    </button>
                                </div>
                            </div>
                            <div class="notification is-dark is-size-7 py-2 px-3 mt-3" style="background-color: rgba(88, 166, 255, 0.1); border: 1px solid var(--border-color);">
                                <span class="icon is-small has-text-info">
                                    <i class="fas fa-shield-alt"></i>
                                </span>
                                <span>Your token is stored locally in your browser and never sent to our servers.</span>
                            </div>
                            <div class="has-text-centered mt-3">
                                <a class="is-size-7 has-text-primary" @onclick="OpenPATModal" style="cursor: pointer;">
                                    <span class="icon is-small">
                                        <i class="fas fa-question-circle"></i>
                                    </span>
                                    <span>How to create a Personal Access Token?</span>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="notification is-success is-light mb-4">
                                <div class="is-flex is-align-items-center">
                                    <span class="icon is-medium has-text-success mr-2">
                                        <i class="fas fa-check-circle fa-lg"></i>
                                    </span>
                                    <div>
                                        <p class="has-text-weight-bold">Authenticated</p>
                                        @if (authSource == "github")
                                        {
                                            <p class="is-size-7">Signed in with GitHub</p>
                                        }
                                        else
                                        {
                                            <p class="is-size-7">Using Personal Access Token</p>
                                        }
                                    </div>
                                </div>
                            </div>

                            <p class="has-text-grey mb-4">
                                You currently have increased API rate limits and access to data based on your token's permissions.
                            </p>

                            <button class="button is-danger is-outlined is-fullwidth" @onclick="RemoveToken">
                                <span class="icon">
                                    <i class="fas fa-sign-out-alt"></i>
                                </span>
                                <span>@(authSource == "github" ? "Sign Out" : "Remove Token")</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Auth Quota Display -->
            <div class="column is-6">
                <GPVBlazor.Components.Displays.AuthQuotaDisplay />
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="section" style="background-color: var(--card-bg);">
    <div class="container">
        <div class="has-text-centered mb-6">
            <h2 class="title is-3 has-text-weight-bold">
                <span class="icon has-text-primary mr-2">
                    <i class="fas fa-cogs"></i>
                </span>
                How It Works
            </h2>
            <p class="subtitle is-5 has-text-grey">Three simple steps to explore any GitHub profile</p>
        </div>
        <div class="columns">
            <div class="column is-4">
                <div class="has-text-centered p-4">
                    <div class="mb-4">
                        <span class="tag is-primary is-large is-rounded" style="width: 50px; height: 50px; font-size: 1.5rem;">1</span>
                    </div>
                    <h3 class="title is-5 mb-3">Search</h3>
                    <p class="has-text-grey">Enter any GitHub username in the search bar to find the profile you want to explore.</p>
                </div>
            </div>
            <div class="column is-4">
                <div class="has-text-centered p-4">
                    <div class="mb-4">
                        <span class="tag is-info is-large is-rounded" style="width: 50px; height: 50px; font-size: 1.5rem;">2</span>
                    </div>
                    <h3 class="title is-5 mb-3">Explore</h3>
                    <p class="has-text-grey">Browse through repositories, view statistics, and analyze the developer's contributions.</p>
                </div>
            </div>
            <div class="column is-4">
                <div class="has-text-centered p-4">
                    <div class="mb-4">
                        <span class="tag is-success is-large is-rounded" style="width: 50px; height: 50px; font-size: 1.5rem;">3</span>
                    </div>
                    <h3 class="title is-5 mb-3">Discover</h3>
                    <p class="has-text-grey">Check followers, following, star history, and connect with the open-source community.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<FeaturesDisplay />

<!-- Personal Access Token Modal -->
<GPVBlazor.Components.Displays.PersonalAccessTokenModal IsActive="@showPATModal" IsActiveChanged="@OnPATModalChanged" />

@code {
    private string? AuthToken { get; set; }
    private bool showPATModal = false;
    private string? authSource;

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }

    private async Task AddToken()
    {
        if (!string.IsNullOrWhiteSpace(AuthToken))
        {
            // Simple validation that it looks like a token if needed, but the API check is better
            bool isValid = await AuthService.IsTokenValidAsync(AuthToken);
            if (!isValid)
            {
                await JS.InvokeAsync<object>("alert", "Invalid token. Please check your GitHub personal access token.");
                return;
            }
            await JS.InvokeVoidAsync("localStorage.setItem", "authToken", AuthToken);
            await JS.InvokeVoidAsync("localStorage.setItem", "authSource", "manual");
            authSource = "manual";
            AuthService.Login(AuthToken);
            // Clear the input
            AuthToken = string.Empty;
        }
    }

    private async Task RemoveToken()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "authSource");
        AuthService.Logout();
        // Force refresh if needed, but state change should handle it
        authSource = null;
    }

    private void HandleInputChange(ChangeEventArgs e)
    {
        AuthToken = e.Value?.ToString();
    }

    private void OpenPATModal()
    {
        showPATModal = true;
    }

    private void OnPATModalChanged(bool isActive)
    {
        showPATModal = isActive;
        StateHasChanged();
    }

    private void SignInWithGitHub()
    {
        var url = AuthService.GetGitHubLoginUrl();
        NavManager.NavigateTo(url, forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            authSource = await JS.InvokeAsync<string>("localStorage.getItem", "authSource");
            
            if (!string.IsNullOrEmpty(token))
            {
                // Sync service if logic didn't happen in Navbar yet or we are first
                if (string.IsNullOrEmpty(AuthService.CurrentAccessToken))
                {
                    AuthService.Login(token);
                }
                StateHasChanged();
            }
        }
    }
}