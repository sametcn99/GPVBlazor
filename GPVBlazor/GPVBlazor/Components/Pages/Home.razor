@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IJSRuntime JS
@inject Services.Interfaces.IAuthService AuthService
@inject NavigationManager NavManager
<PageTitle>GitHub Profile Viewer - Explore GitHub Profiles</PageTitle>

<!-- Hero Section -->
<section class="hero is-medium hero-modern">
    <!-- Animated Background Elements -->
    <div class="hero-bg-decoration">
        <div class="floating-shape shape-1"></div>
        <div class="floating-shape shape-2"></div>
        <div class="floating-shape shape-3"></div>
        <div class="gradient-orb"></div>
    </div>

    <div class="hero-body">
        <div class="container has-text-centered" style="position: relative; z-index: 2;">
            <!-- Logo with Glow Effect -->
            <div class="hero-icon-wrapper mb-5">
                <div class="icon-glow"></div>
                <span class="icon is-large hero-github-icon">
                    <i class="fab fa-github"></i>
                </span>
            </div>

            <!-- Main Title with Gradient -->
            <h1 class="title is-1 is-size-2-mobile has-text-weight-bold mb-4 hero-title">
                <span class="gradient-text">GitHub Profile</span> Viewer
            </h1>

            <!-- Subtitle with Badge -->
            <div class="hero-subtitle-wrapper mb-4">
                <p class="subtitle is-4 is-size-5-mobile has-text-grey-light mb-3" style="max-width: 700px; margin: 0 auto;">
                    A comprehensive tool for exploring GitHub profiles, repositories, and developer statistics
                </p>
                <div class="hero-badges">
                    <span class="hero-badge">
                        <i class="fas fa-bolt"></i> Fast
                    </span>
                    <span class="hero-badge">
                        <i class="fas fa-shield-alt"></i> Secure
                    </span>
                    <span class="hero-badge">
                        <i class="fas fa-code-branch"></i> Open Source
                    </span>
                </div>
            </div>

            <!-- Description -->
            <p class="is-size-6 has-text-grey mb-5" style="max-width: 600px; margin: 0 auto;">
                Search for any GitHub user to view their profile details, repository information,
                star history, gists, and network connections — all in one place.
            </p>

                <GPVBlazor.Components.Displays.SearchBarDisplay />

            <!-- Stats Showcase -->
            <div class="hero-stats mt-6">
                <div class="hero-stat">
                    <span class="hero-stat-icon"><i class="fas fa-users"></i></span>
                    <span class="hero-stat-text">100M+ GitHub Users</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                    <span class="hero-stat-icon"><i class="fas fa-code"></i></span>
                    <span class="hero-stat-text">400M+ Repositories</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                    <span class="hero-stat-icon"><i class="fas fa-star"></i></span>
                    <span class="hero-stat-text">Free Forever</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Wave Decoration -->
    <div class="hero-wave">
        <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
            <path d="M0 120L60 105C120 90 240 60 360 45C480 30 600 30 720 37.5C840 45 960 60 1080 67.5C1200 75 1320 75 1380 75L1440 75V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0V120Z" fill="var(--dark-bg)"/>
        </svg>
    </div>
</section>

<!-- Main Content Grid -->
<section class="section section-modern">
    <div class="container">
        <div class="has-text-centered mb-6">
            <span class="section-label">
                <i class="fas fa-unlock-alt"></i> Authentication
            </span>
            <h2 class="title is-3 has-text-weight-bold mt-3">
                Unlock <span class="gradient-text">Premium Features</span>
            </h2>
            <p class="subtitle is-5 has-text-grey" style="max-width: 600px; margin: 0 auto;">
                Add your GitHub token for higher rate limits and access to more data
            </p>
        </div>
        <div class="columns is-multiline is-variable is-6">
            <!-- Auth Token Section -->
            <div class="column is-6">
                <div class="modern-card auth-card">
                    <div class="card-icon-badge warning">
                        <i class="fas fa-key"></i>
                    </div>
                    <div class="modern-card-header">
                        <h2 class="title is-5 mb-1">Authentication Status</h2>
                        <p class="is-size-7 has-text-grey">Manage your access level</p>
                    </div>
                    <div class="modern-card-content">
                        @if (string.IsNullOrEmpty(AuthService.CurrentAccessToken))
                        {
                            <p class="is-size-6 has-text-grey-light mb-4">
                                Add your GitHub personal access token to unlock higher API rate limits
                                and access private repository information.
                            </p>

                            <div class="field mb-4">
                                <button class="button github-signin-btn is-fullwidth" @onclick="SignInWithGitHub">
                                    <span class="icon">
                                        <i class="fab fa-github"></i>
                                    </span>
                                    <span>Sign in with GitHub</span>
                                </button>
                            </div>

                            <div class="divider-modern">
                                <span>OR</span>
                            </div>

                            <div class="field">
                                <label class="label is-small has-text-grey-light">Personal Access Token</label>
                                <div class="control has-icons-left">
                                    <input @bind="AuthToken" placeholder="ghp_xxxxxxxxxxxx" class="input modern-input"
                                        type="password" @oninput="HandleInputChange" />
                                    <span class="icon is-small is-left">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                </div>
                            </div>
                            <div class="field">
                                <div class="control">
                                    <button class="button is-primary is-fullwidth modern-btn" @onclick="AddToken">
                                        <span class="icon">
                                            <i class="fas fa-plus-circle"></i>
                                        </span>
                                        <span>Save Token</span>
                                    </button>
                                </div>
                            </div>
                            <div class="info-badge mt-4">
                                <span class="icon is-small has-text-info">
                                    <i class="fas fa-shield-alt"></i>
                                </span>
                                <span>Your session is stored in a secure HttpOnly cookie and GitHub tokens stay on the server.</span>
                            </div>
                            <div class="has-text-centered mt-3">
                                <a class="help-link" @onclick="OpenPATModal" style="cursor: pointer;">
                                    <span class="icon is-small">
                                        <i class="fas fa-question-circle"></i>
                                    </span>
                                    <span>How to create a Personal Access Token?</span>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="success-badge mb-4">
                                <div class="success-badge-icon">
                                    <i class="fas fa-check"></i>
                                </div>
                                <div>
                                    <p class="has-text-weight-bold has-text-success">Authenticated</p>
                                    @if (authSource == "github")
                                    {
                                        <p class="is-size-7 has-text-grey">Signed in with GitHub</p>
                                    }
                                    else
                                    {
                                        <p class="is-size-7 has-text-grey">Using Personal Access Token</p>
                                    }
                                </div>
                            </div>

                            <p class="has-text-grey mb-4">
                                You currently have increased API rate limits and access to data based on your token's permissions.
                            </p>

                            <button class="button is-danger is-outlined is-fullwidth modern-btn-outline" @onclick="RemoveToken">
                                <span class="icon">
                                    <i class="fas fa-sign-out-alt"></i>
                                </span>
                                <span>@(authSource == "github" ? "Sign Out" : "Remove Token")</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Auth Quota Display -->
            <div class="column is-6">
                <GPVBlazor.Components.Displays.AuthQuotaDisplay />
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="section section-modern section-alternate">
    <div class="container">
        <div class="has-text-centered mb-6">
            <span class="section-label">
                <i class="fas fa-magic"></i> Simple & Intuitive
            </span>
            <h2 class="title is-3 has-text-weight-bold mt-3">
                How It <span class="gradient-text">Works</span>
            </h2>
            <p class="subtitle is-5 has-text-grey" style="max-width: 500px; margin: 0 auto;">
                Three simple steps to explore any GitHub profile
            </p>
        </div>
        <div class="columns is-variable is-6">
            <div class="column is-4">
                <div class="step-card">
                    <div class="step-connector"></div>
                    <div class="step-number step-primary">
                        <span>1</span>
                    </div>
                    <div class="step-icon">
                        <i class="fas fa-search"></i>
                    </div>
                    <h3 class="title is-5 mb-3">Search</h3>
                    <p class="has-text-grey">Enter any GitHub username in the search bar to find the profile you want to explore.</p>
                </div>
            </div>
            <div class="column is-4">
                <div class="step-card">
                    <div class="step-connector"></div>
                    <div class="step-number step-info">
                        <span>2</span>
                    </div>
                    <div class="step-icon">
                        <i class="fas fa-binoculars"></i>
                    </div>
                    <h3 class="title is-5 mb-3">Explore</h3>
                    <p class="has-text-grey">Browse through repositories, view statistics, and analyze the developer's contributions.</p>
                </div>
            </div>
            <div class="column is-4">
                <div class="step-card">
                    <div class="step-number step-success">
                        <span>3</span>
                    </div>
                    <div class="step-icon">
                        <i class="fas fa-gem"></i>
                    </div>
                    <h3 class="title is-5 mb-3">Discover</h3>
                    <p class="has-text-grey">Check followers, following, star history, and connect with the open-source community.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Profiles Showcase Section -->
<section class="section section-modern">
    <div class="container">
        <div class="has-text-centered mb-6">
            <span class="section-label">
                <i class="fas fa-user-astronaut"></i> Featured Developers
            </span>
            <h2 class="title is-3 has-text-weight-bold mt-3">
                Discover <span class="gradient-text">Popular Profiles</span>
            </h2>
            <p class="subtitle is-5 has-text-grey" style="max-width: 600px; margin: 0 auto;">
                Get started by exploring profiles of notable developers and open-source contributors
            </p>
        </div>
        <div class="profile-grid">
            @foreach (var profile in featuredProfiles)
            {
                <a href="/p/@profile.Username" class="profile-card-modern">
                    <div class="profile-card-glow"></div>
                    <div class="profile-card-content">
                        <div class="profile-avatar-wrapper">
                            <img src="https://avatars.githubusercontent.com/@profile.Username" alt="@profile.Name" loading="lazy" />
                            <div class="profile-avatar-ring"></div>
                        </div>
                        <p class="profile-name">@profile.Name</p>
                        <p class="profile-username">@@@profile.Username</p>
                        <span class="profile-view-btn">
                            <i class="fas fa-arrow-right"></i>
                            View Profile
                        </span>
                    </div>
                </a>
            }
        </div>
        <div class="has-text-centered mt-6">
            <div class="tip-box">
                <span class="icon is-small has-text-info mr-2">
                    <i class="fas fa-lightbulb"></i>
                </span>
                <span>Or search for any GitHub username above to explore their profile</span>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<FeaturesDisplay />

<!-- Use Cases / Benefits Section -->
<section class="section section-modern section-alternate">
    <div class="container">
        <div class="has-text-centered mb-6">
            <span class="section-label">
                <i class="fas fa-bullseye"></i> Who It's For
            </span>
            <h2 class="title is-3 has-text-weight-bold mt-3">
                Perfect For <span class="gradient-text">Everyone</span>
            </h2>
            <p class="subtitle is-5 has-text-grey" style="max-width: 600px; margin: 0 auto;">
                Whether you're a developer, recruiter, or learner — GPV helps you explore GitHub like never before
            </p>
        </div>
        <div class="columns is-multiline is-variable is-5">
            @foreach (var useCase in useCases)
            {
                <div class="column is-4-desktop is-6-tablet">
                    <div class="usecase-card">
                        <div class="usecase-icon-wrapper @useCase.Color">
                            <i class="@useCase.Icon"></i>
                        </div>
                        <h3 class="title is-5 mb-2">@useCase.Title</h3>
                        <p class="has-text-grey-light">@useCase.Description</p>
                        <div class="usecase-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Technology Stack Section -->
<section class="section section-modern">
    <div class="container">
        <div class="has-text-centered mb-6">
            <span class="section-label">
                <i class="fas fa-layer-group"></i> Technology Stack
            </span>
            <h2 class="title is-3 has-text-weight-bold mt-3">
                Built With <span class="gradient-text">Modern Tech</span>
            </h2>
            <p class="subtitle is-5 has-text-grey" style="max-width: 600px; margin: 0 auto;">
                Powered by cutting-edge technologies for speed, reliability, and great developer experience
            </p>
        </div>
        <div class="tech-grid">
            @foreach (var tech in technologies)
            {
                <div class="tech-card-modern">
                    <div class="tech-icon-wrapper @tech.Color">
                        <i class="@tech.Icon"></i>
                    </div>
                    <p class="tech-name">@tech.Name</p>
                    <p class="tech-description">@tech.Description</p>
                </div>
            }
        </div>
        <div class="has-text-centered mt-6">
            <div class="feature-pills">
                <span class="feature-pill success">
                    <i class="fas fa-lock"></i>
                    Secure
                </span>
                <span class="feature-pill info">
                    <i class="fas fa-bolt"></i>
                    Fast
                </span>
                <span class="feature-pill warning">
                    <i class="fas fa-code-branch"></i>
                    Open Source
                </span>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="section section-modern section-alternate">
    <div class="container">
        <div class="has-text-centered mb-6">
            <span class="section-label">
                <i class="fas fa-question-circle"></i> FAQ
            </span>
            <h2 class="title is-3 has-text-weight-bold mt-3">
                Frequently Asked <span class="gradient-text">Questions</span>
            </h2>
            <p class="subtitle is-5 has-text-grey" style="max-width: 600px; margin: 0 auto;">
                Quick answers to common questions about GitHub Profile Viewer
            </p>
        </div>
        <div class="columns is-centered">
            <div class="column is-8">
                <div class="faq-list">
                    @foreach (var faq in faqs)
                    {
                        <div class="faq-item-modern">
                            <div class="faq-question">
                                <span class="faq-icon">
                                    <i class="fas fa-chevron-right"></i>
                                </span>
                                <h3>@faq.Question</h3>
                            </div>
                            <div class="faq-answer">
                                <p>@faq.Answer</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Open Source CTA Section -->
<section class="section section-modern">
    <div class="container">
        <div class="cta-modern">
            <div class="cta-bg-elements">
                <div class="cta-orb cta-orb-1"></div>
                <div class="cta-orb cta-orb-2"></div>
            </div>
            <div class="cta-content">
                <div class="cta-icon-wrapper">
                    <i class="fas fa-heart"></i>
                </div>
                <h2 class="title is-2 mb-3 has-text-white">
                    Open Source & <span class="cta-highlight">Community Driven</span>
                </h2>
                <p class="subtitle is-5 has-text-grey-lighter mb-5" style="max-width: 600px; margin: 0 auto;">
                    GPV is built by the community, for the community. We welcome contributions of all kinds!
                </p>
                <div class="cta-buttons">
                    <a href="https://github.com/sametcn99/GPVBlazor" target="_blank" rel="noopener" class="cta-btn cta-btn-primary">
                        <span class="icon">
                            <i class="fab fa-github"></i>
                        </span>
                        <span>View on GitHub</span>
                    </a>
                    <a href="https://github.com/sametcn99/GPVBlazor/stargazers" target="_blank" rel="noopener" class="cta-btn cta-btn-secondary">
                        <span class="icon">
                            <i class="fas fa-star"></i>
                        </span>
                        <span>Star Project</span>
                    </a>
                    <a href="https://github.com/sametcn99/GPVBlazor/issues" target="_blank" rel="noopener" class="cta-btn cta-btn-outline">
                        <span class="icon">
                            <i class="fas fa-bug"></i>
                        </span>
                        <span>Report Issues</span>
                    </a>
                </div>
                <p class="is-size-7 has-text-grey-light mt-5">
                    <span class="icon is-small mr-1">
                        <i class="fas fa-code-branch"></i>
                    </span>
                    Fork, contribute, and help us make GPV even better!
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Personal Access Token Modal -->
<GPVBlazor.Components.Displays.PersonalAccessTokenModal IsActive="@showPATModal" IsActiveChanged="@OnPATModalChanged" />

@code {
    private string? AuthToken { get; set; }
    private bool showPATModal = false;
    private string? authSource;

    // Featured Profiles Data
    private List<FeaturedProfile> featuredProfiles = new()
    {
        new FeaturedProfile { Username = "torvalds", Name = "Linus Torvalds" },
        new FeaturedProfile { Username = "gaearon", Name = "Dan Abramov" },
        new FeaturedProfile { Username = "sindresorhus", Name = "Sindre Sorhus" },
        new FeaturedProfile { Username = "tj", Name = "TJ Holowaychuk" },
        new FeaturedProfile { Username = "yyx990803", Name = "Evan You" },
        new FeaturedProfile { Username = "addyosmani", Name = "Addy Osmani" }
    };

    // Use Cases Data
    private List<UseCase> useCases = new()
    {
        new UseCase
        {
            Icon = "fas fa-laptop-code",
            Title = "Developers",
            Description = "Explore other developers' projects, discover coding patterns, and find inspiration for your next project.",
            Color = "primary"
        },
        new UseCase
        {
            Icon = "fas fa-user-tie",
            Title = "Recruiters",
            Description = "Quickly evaluate candidates' GitHub portfolios, assess their contributions, and understand their technical expertise.",
            Color = "info"
        },
        new UseCase
        {
            Icon = "fas fa-graduation-cap",
            Title = "Learners",
            Description = "Find inspiration from experienced developers, study popular repositories, and learn best practices from the best.",
            Color = "success"
        },
        new UseCase
        {
            Icon = "fas fa-chart-pie",
            Title = "Researchers",
            Description = "Analyze open-source trends, track popular technologies, and gather insights about the developer ecosystem.",
            Color = "warning"
        },
        new UseCase
        {
            Icon = "fas fa-hands-helping",
            Title = "Open Source Contributors",
            Description = "Discover projects to contribute to, find active maintainers, and connect with the open-source community.",
            Color = "danger"
        },
        new UseCase
        {
            Icon = "fas fa-briefcase",
            Title = "Project Managers",
            Description = "Evaluate potential team members, assess project activity, and make data-driven hiring decisions.",
            Color = "link"
        }
    };

    // Technologies Data
    private List<Technology> technologies = new()
    {
        new Technology { Icon = "fab fa-microsoft", Name = ".NET 9", Description = "Backend Framework", Color = "link" },
        new Technology { Icon = "fas fa-fire", Name = "Blazor Server", Description = "Interactive UI", Color = "danger" },
        new Technology { Icon = "fab fa-css3-alt", Name = "Bulma CSS", Description = "Styling Framework", Color = "info" },
        new Technology { Icon = "fas fa-chart-bar", Name = "Chart.js", Description = "Data Visualization", Color = "warning" },
        new Technology { Icon = "fab fa-docker", Name = "Docker", Description = "Containerization", Color = "primary" }
    };

    // FAQ Data
    private List<FaqItem> faqs = new()
    {
        new FaqItem
        {
            Question = "Is GitHub Profile Viewer free to use?",
            Answer = "Yes! GPV is completely free and open source. You can use all features without any cost, and even contribute to the project on GitHub."
        },
        new FaqItem
        {
            Question = "Do I need a GitHub token to use GPV?",
            Answer = "A token is optional but recommended. Without a token, you're limited to 60 API requests per hour. With a personal access token, you get 5,000 requests per hour."
        },
        new FaqItem
        {
            Question = "Is my personal access token secure?",
            Answer = "GPV stores authentication in a secure HttpOnly session cookie. GitHub access tokens are kept server-side and are not exposed to browser storage."
        },
        new FaqItem
        {
            Question = "Can I see private repositories?",
            Answer = "Only if you provide a personal access token with the appropriate permissions. Without proper token permissions, only public repositories are visible."
        },
        new FaqItem
        {
            Question = "What data does GPV provide about a profile?",
            Answer = "GPV shows comprehensive profile information including repositories, stars, forks, languages used, contribution statistics, followers, following, gists, and interactive charts."
        },
        new FaqItem
        {
            Question = "Is there an API available?",
            Answer = "Yes! You can explore our comprehensive API documentation and test endpoints directly by visiting <a href='/docs'>/docs</a>."
        }
    };

    // Model Classes
    private class FeaturedProfile
    {
        public string Username { get; set; } = "";
        public string Name { get; set; } = "";
    }

    private class UseCase
    {
        public string Icon { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Color { get; set; } = "primary";
    }

    private class Technology
    {
        public string Icon { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Color { get; set; } = "primary";
    }

    private class FaqItem
    {
        public string Question { get; set; } = "";
        public string Answer { get; set; } = "";
    }

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }

    private async Task AddToken()
    {
        if (!string.IsNullOrWhiteSpace(AuthToken))
        {
            bool isValid = await JS.InvokeAsync<bool>("gpvAuth.signInWithToken", AuthToken);
            if (!isValid)
            {
                await JS.InvokeAsync<object>("alert", "Invalid token. Please check your GitHub personal access token.");
                return;
            }

            AuthToken = string.Empty;
            NavManager.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task RemoveToken()
    {
        await JS.InvokeAsync<bool>("gpvAuth.signOut");
        authSource = null;
        NavManager.NavigateTo("/", forceLoad: true);
    }

    private void HandleInputChange(ChangeEventArgs e)
    {
        AuthToken = e.Value?.ToString();
    }

    private void OpenPATModal()
    {
        showPATModal = true;
    }

    private void OnPATModalChanged(bool isActive)
    {
        showPATModal = isActive;
        StateHasChanged();
    }

    private void SignInWithGitHub()
    {
        NavManager.NavigateTo("/api/auth/login", forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitializeFromSessionAsync();
            authSource = AuthService.CurrentAuthSource;
            StateHasChanged();
        }
    }
}
