@page "/p/{Username}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject Services.Interfaces.IUserService UserService
@inject Services.Interfaces.IContactService ContactService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@using GPVBlazor.Models
@using GPVBlazor.Components.Displays

<PageTitle>@Username's Profile</PageTitle>

<div class="container mt-5 mb-6">
    @if (user is not null)
    {
        <UserProfileDisplay UserProfile="@user" token="@token" />
    }
    else
    {
        <LoadingDisplay />
    }

    @if (stats is not null && repositories is not null)
    {
        <UserStatisticsDisplay UserStats="@stats" Repositories="@repositories" User="@user" Token="@token" />
    }
    else if (user is not null)
    {
        <LoadingDisplay />
    }

    @if (repositories is not null || gists is not null)
    {
        <div class="repositories-section box">
            <div class="tabs is-boxed mb-4">
                <ul>
                    <li class="@(activeTab == "repositories" ? "is-active" : "")">
                        <a @onclick='() => activeTab = "repositories"'>
                            <span class="icon is-small"><i class="fas fa-book" aria-hidden="true"></i></span>
                            <span>Repositories</span>
                            @if (user?.PublicRepos > 0)
                            {
                                <span class="tag is-rounded ml-2">@user.PublicRepos</span>
                            }
                        </a>
                    </li>
                    <li class="@(activeTab == "gists" ? "is-active" : "")">
                        <a @onclick='() => activeTab = "gists"'>
                            <span class="icon is-small"><i class="fas fa-code" aria-hidden="true"></i></span>
                            <span>Gists</span>
                            @if (user?.PublicGists > 0)
                            {
                                <span class="tag is-rounded ml-2">@user.PublicGists</span>
                            }
                        </a>
                    </li>
                    <li class="@(activeTab == "activities" ? "is-active" : "")">
                        <a @onclick='() => activeTab = "activities"'>
                            <span class="icon is-small"><i class="fas fa-history" aria-hidden="true"></i></span>
                            <span>Activities</span>
                        </a>
                    </li>
                </ul>
            </div>

            @if (activeTab == "repositories")
            {
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="section-icon">
                            <i class="fas fa-folder-open"></i>
                        </span>
                        <span>All Repositories</span>
                        <span class="repo-count-badge">@FilteredCount</span>
                    </h2>
                    <div class="view-options">
                        <button class="view-btn @(viewMode == "grid" ? "active" : "")" @onclick='() => viewMode = "grid"' title="Grid view">
                            <i class="fas fa-th-large"></i>
                        </button>
                        <button class="view-btn @(viewMode == "list" ? "active" : "")" @onclick='() => viewMode = "list"' title="List view">
                            <i class="fas fa-list"></i>
                        </button>
                    </div>
                </div>
                
                <GPVBlazor.Components.Displays.FilterDisplays.RepositoryFilterBar Repositories="repositories"
                                                                                  OnFilteredRepositoriesChanged="UpdateFilteredRepositories"
                                                                                  PageSize="pageSize"
                                                                                  OnPageSizeChanged="HandlePageSizeChanged" />

                @if (pagedRepositories.Any())
                {
                    <div class="@(viewMode == "grid" ? "repo-grid" : "repo-list")">
                        @foreach (var repo in pagedRepositories)
                        {
                            <div class="@(viewMode == "grid" ? "repo-grid-item" : "repo-list-item")">
                                <RepositoryDisplay repository="repo" Token="@token" @key="repo.NodeId" />
                            </div>
                        }
                    </div>

                    @if (TotalPages > 1)
                    {
                        <div class="pagination-wrapper">
                            <div class="pagination-info">
                                Showing <strong>@((currentPage - 1) * pageSize + 1)</strong> - <strong>@Math.Min(currentPage * pageSize, FilteredCount)</strong> of <strong>@FilteredCount</strong> repositories
                            </div>
                            <nav class="pagination is-rounded is-small is-centered" role="navigation" aria-label="Pagination Navigation">
                                <ul class="pagination-list is-flex is-align-items-center is-justify-content-center">
                                    <li>
                                        <button class="pagination-link icon-only"
                                                title="First page"
                                                aria-label="Go to first page"
                                                @onclick="GoToFirst"
                                                disabled="@(!CanGoPrevious)">
                                            <span class="icon is-small">
                                                <i class="fas fa-angle-double-left"></i>
                                            </span>
                                        </button>
                                    </li>
                                    <li>
                                        <button class="pagination-link icon-only"
                                                title="Previous page"
                                                aria-label="Go to previous page"
                                                @onclick="PreviousPage"
                                                disabled="@(!CanGoPrevious)">
                                            <span class="icon is-small">
                                                <i class="fas fa-chevron-left"></i>
                                            </span>
                                        </button>
                                    </li>
                                    @foreach (var item in PaginationItems)
                                    {
                                        <li>
                                            @if (item.IsPage)
                                            {
                                                <button class="@GetPageButtonClass(item.PageNumber)"
                                                        aria-label="@GetPageAriaLabel(item.PageNumber)"
                                                        aria-current="@GetAriaCurrent(item.PageNumber)"
                                                        @onclick="@(() => GoToPage(item.PageNumber))"
                                                        disabled="@(item.PageNumber == currentPage)">
                                                    @item.PageNumber
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="pagination-ellipsis" aria-hidden="true">&hellip;</span>
                                            }
                                        </li>
                                    }
                                    <li>
                                        <button class="pagination-link icon-only"
                                                title="Next page"
                                                aria-label="Go to next page"
                                                @onclick="NextPage"
                                                disabled="@(!CanGoNext)">
                                            <span class="icon is-small">
                                                <i class="fas fa-chevron-right"></i>
                                            </span>
                                        </button>
                                    </li>
                                    <li>
                                        <button class="pagination-link icon-only"
                                                title="Last page"
                                                aria-label="Go to last page"
                                                @onclick="GoToLast"
                                                disabled="@(!CanGoNext)">
                                            <span class="icon is-small">
                                                <i class="fas fa-angle-double-right"></i>
                                            </span>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fas fa-search"></i>
                        </div>
                        <p class="empty-title">No repositories found</p>
                        <p class="empty-description">No repositories match the current filters. Try adjusting your search criteria.</p>
                    </div>
                }
            }
            else if (activeTab == "gists")
            {
                <div class="section-header">
                     <h2 class="section-title">
                        <span class="section-icon">
                            <i class="fas fa-code"></i>
                        </span>
                        <span>All Gists</span>
                        <span class="repo-count-badge">@GistFilteredCount</span>
                    </h2>
                    <div class="view-options">
                        <button class="view-btn @(viewMode == "grid" ? "active" : "")" @onclick='() => viewMode = "grid"' title="Grid view">
                            <i class="fas fa-th-large"></i>
                        </button>
                        <button class="view-btn @(viewMode == "list" ? "active" : "")" @onclick='() => viewMode = "list"' title="List view">
                            <i class="fas fa-list"></i>
                        </button>
                    </div>
                </div>

                <GPVBlazor.Components.Displays.FilterDisplays.GistFilterBar Gists="gists"
                                                                            OnFilteredGistsChanged="UpdateFilteredGists"
                                                                            PageSize="gistPageSize"
                                                                            OnPageSizeChanged="HandleGistPageSizeChanged" />

                @if (pagedGists.Any())
                {
                    <div class="@(viewMode == "grid" ? "repo-grid" : "repo-list")">
                        @foreach (var gist in pagedGists)
                        {
                            <div class="@(viewMode == "grid" ? "repo-grid-item" : "repo-list-item")">
                                <GistDisplay Gist="gist" @key="gist.NodeId" />
                            </div>
                        }
                    </div>
                    
                     @if (GistTotalPages > 1)
                    {
                        <div class="pagination-wrapper">
                            <div class="pagination-info">
                                Showing <strong>@((gistCurrentPage - 1) * gistPageSize + 1)</strong> - <strong>@Math.Min(gistCurrentPage * gistPageSize, GistFilteredCount)</strong> of <strong>@GistFilteredCount</strong> gists
                            </div>
                            <nav class="pagination is-rounded is-small is-centered" role="navigation" aria-label="Pagination Navigation">
                                <ul class="pagination-list is-flex is-align-items-center is-justify-content-center">
                                    <li>
                                        <button class="pagination-link icon-only"
                                                title="First page"
                                                aria-label="Go to first page"
                                                @onclick="GoToFirstGist"
                                                disabled="@(!CanGoPreviousGist)">
                                            <span class="icon is-small">
                                                <i class="fas fa-angle-double-left"></i>
                                            </span>
                                        </button>
                                    </li>
                                    <li>
                                        <button class="pagination-link icon-only"
                                                title="Previous page"
                                                aria-label="Go to previous page"
                                                @onclick="PreviousGistPage"
                                                disabled="@(!CanGoPreviousGist)">
                                            <span class="icon is-small">
                                                <i class="fas fa-chevron-left"></i>
                                            </span>
                                        </button>
                                    </li>
                                    @foreach (var item in GistPaginationItems)
                                    {
                                        <li>
                                            @if (item.IsPage)
                                            {
                                                <button class="@GetGistPageButtonClass(item.PageNumber)"
                                                        aria-label="@GetGistPageAriaLabel(item.PageNumber)"
                                                        aria-current="@GetGistAriaCurrent(item.PageNumber)"
                                                        @onclick="@(() => GoToGistPage(item.PageNumber))"
                                                        disabled="@(item.PageNumber == gistCurrentPage)">
                                                    @item.PageNumber
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="pagination-ellipsis" aria-hidden="true">&hellip;</span>
                                            }
                                        </li>
                                    }
                                    <li>
                                        <button class="pagination-link icon-only"
                                                title="Next page"
                                                aria-label="Go to next page"
                                                @onclick="NextGistPage"
                                                disabled="@(!CanGoNextGist)">
                                            <span class="icon is-small">
                                                <i class="fas fa-chevron-right"></i>
                                            </span>
                                        </button>
                                    </li>
                                    <li>
                                        <button class="pagination-link icon-only"
                                                title="Last page"
                                                aria-label="Go to last page"
                                                @onclick="GoToLastGist"
                                                disabled="@(!CanGoNextGist)">
                                            <span class="icon is-small">
                                                <i class="fas fa-angle-double-right"></i>
                                            </span>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fas fa-code"></i>
                        </div>
                        <p class="empty-title">No gists found</p>
                        <p class="empty-description">This user has no public gists.</p>
                    </div>
                }
            }
            else if (activeTab == "activities")
            {
                <div class="section-header">
                     <h2 class="section-title">
                        <span class="section-icon">
                            <i class="fas fa-history"></i>
                        </span>
                        <span>Recent Activity</span>
                    </h2>
                </div>

                @if (activities != null && activities.Any())
                {
                    <div class="activity-list">
                        @foreach (var activity in activities)
                        {
                            <ActivityDisplay Activity="activity" @key="activity.Id" />
                        }
                    </div>

                    @if (hasMoreActivities)
                    {
                        <div class="has-text-centered mt-4">
                            <button class="button is-fullwidth load-more-btn @(isLoadingMoreActivities ? "is-loading" : "")" @onclick="LoadMoreActivities">
                                Load More Activity
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fas fa-history"></i>
                        </div>
                        <p class="empty-title">No recent activity</p>
                        <p class="empty-description">This user has no recent public activity.</p>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string? Username { get; set; }
    private User? user;
    private List<Repository>? repositories;
    private List<Repository> filteredRepositories = new();
    private List<Repository> pagedRepositories = new();
    private List<Gist>? gists;
    private List<Gist> filteredGists = new();
    private List<Gist> pagedGists = new();
    private List<Activity>? activities;
    private int activityPage = 1;
    private bool hasMoreActivities = true;
    private bool isLoadingMoreActivities = false;
    private RepositoryStats? stats;
    string? token;
    private int currentPage = 1;
    private int pageSize = 6;
    private int gistCurrentPage = 1;
    private int gistPageSize = 6;
    private string viewMode = "grid";
    private string activeTab = "repositories";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
                
                if (string.IsNullOrWhiteSpace(token))
                {
                    await JS.InvokeVoidAsync("alert", "You need to add a auth token in home page.");
                    NavigationManager.NavigateTo("/");
                    return;
                }

                if (!string.IsNullOrWhiteSpace(Username))
                {
                    await LoadUserData();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error in OnAfterRenderAsync: {ex.Message}");
                await JS.InvokeVoidAsync("alert", "An error occurred while loading the profile. Please try again.");
                NavigationManager.NavigateTo("/");
            }
            finally
            {
                StateHasChanged();
            }
        }
    }

    private async Task LoadUserData()
    {
        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(token))
            return;

        try
        {
            user = await UserService.FetchUserProfile(Username, token);
            StateHasChanged();

            if (user is not null)
            {
                var repoTask = UserService.FetchUserRepositories(Username, token, user.PublicRepos);
                var gistTask = UserService.FetchUserGists(Username, token, user.PublicGists);
                var activityTask = UserService.FetchUserActivities(Username, token, 1, 30);

                await Task.WhenAll(repoTask, gistTask, activityTask);

                repositories = await repoTask ?? new List<Repository>();
                gists = await gistTask ?? new List<Gist>();
                var activityResult = await activityTask;
                activities = activityResult.Activities ?? new List<Activity>();

                // Fix for PublicEvent showing repo creation date
                if (activities.Any() && repositories.Any())
                {
                    foreach (var activity in activities.Where(a => a.Type == "PublicEvent"))
                    {
                        var repo = repositories.FirstOrDefault(r => r.FullName == activity.Repo.Name);
                        if (repo != null)
                        {
                            activity.Repo.CreatedAt = repo.CreatedAt;

                            if (repo.CreatedAt.HasValue && repo.UpdatedAt.HasValue)
                            {
                                // Check if dates are close (within 1 minute) to account for any small diffs
                                if (Math.Abs((activity.CreatedAt - repo.CreatedAt.Value).TotalMinutes) < 1)
                                {
                                    activity.CreatedAt = repo.UpdatedAt.Value;
                                }
                            }
                        }
                    }
                }
                
                hasMoreActivities = activityResult.HasNextPage;
                activityPage = 1;

                filteredRepositories = repositories.ToList();
                filteredGists = gists.ToList();
                
                currentPage = 1;
                gistCurrentPage = 1;
                
                UpdatePagination();
                UpdateGistPagination();

                if (repositories.Any())
                {
                    stats = new RepositoryStats(repositories);
                    StateHasChanged();
                    repositories = await UserService.FetchReadmes(Username, token, repositories);
                    filteredRepositories = repositories.ToList();
                    UpdatePagination();
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user data: {ex.Message}");
            throw;
        }
    }

    private async Task LoadMoreActivities()
    {
        if (isLoadingMoreActivities || !hasMoreActivities || string.IsNullOrWhiteSpace(Username)) return;

        isLoadingMoreActivities = true;
        StateHasChanged();

        try
        {
            activityPage++;
            var result = await UserService.FetchUserActivities(Username, token, activityPage, 30);
            var newActivities = result.Activities;
            
            if (newActivities != null && newActivities.Any())
            {
                // Fix for PublicEvent showing repo creation date
                if (repositories != null && repositories.Any())
                {
                    foreach (var activity in newActivities.Where(a => a.Type == "PublicEvent"))
                    {
                        var repo = repositories.FirstOrDefault(r => r.FullName == activity.Repo.Name);
                        if (repo != null)
                        {
                            activity.Repo.CreatedAt = repo.CreatedAt;

                            if (repo.CreatedAt.HasValue && repo.UpdatedAt.HasValue)
                            {
                                if (Math.Abs((activity.CreatedAt - repo.CreatedAt.Value).TotalMinutes) < 1)
                                {
                                    activity.CreatedAt = repo.UpdatedAt.Value;
                                }
                            }
                        }
                    }
                }

                activities?.AddRange(newActivities);
                hasMoreActivities = result.HasNextPage;
            }
            else
            {
                hasMoreActivities = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading more activities: {ex.Message}");
        }
        finally
        {
            isLoadingMoreActivities = false;
            StateHasChanged();
        }
    }

    private void UpdateFilteredRepositories(List<Repository> filteredRepositories)
    {
        this.filteredRepositories = filteredRepositories ?? new List<Repository>();
        currentPage = 1;
        UpdatePagination();
    }

    private void UpdateFilteredGists(List<Gist> filteredGists)
    {
        this.filteredGists = filteredGists ?? new List<Gist>();
        gistCurrentPage = 1;
        UpdateGistPagination();
    }

    private void UpdatePagination()
    {
        if (filteredRepositories == null || filteredRepositories.Count == 0)
        {
            pagedRepositories = new List<Repository>();
            currentPage = 1;
            StateHasChanged();
            return;
        }

        var totalPages = TotalPages;
        if (totalPages == 0)
        {
            pagedRepositories = new List<Repository>();
            currentPage = 1;
            StateHasChanged();
            return;
        }

        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }

        if (currentPage < 1)
        {
            currentPage = 1;
        }

        var effectivePageSize = Math.Max(pageSize, 1);
        var skip = (currentPage - 1) * effectivePageSize;
        pagedRepositories = filteredRepositories.Skip(skip).Take(effectivePageSize).ToList();
        StateHasChanged();
    }

    private int TotalPages
    {
        get
        {
            if (filteredRepositories?.Count > 0)
            {
                var effectivePageSize = Math.Max(pageSize, 1);
                return (int)Math.Ceiling((double)filteredRepositories.Count / effectivePageSize);
            }

            return 0;
        }
    }

    private int FilteredCount => filteredRepositories?.Count ?? 0;
    private bool CanGoPrevious => currentPage > 1;
    private bool CanGoNext => currentPage < TotalPages;
    private bool CanJumpToFirst => CanGoPrevious;
    private bool CanJumpToLast => CanGoNext;

    private IEnumerable<PaginationItem> PaginationItems
    {
        get
        {
            var totalPages = TotalPages;
            if (totalPages == 0)
            {
                return Enumerable.Empty<PaginationItem>();
            }

            var items = new List<PaginationItem>();

            if (totalPages <= 7)
            {
                for (var page = 1; page <= totalPages; page++)
                {
                    items.Add(new PaginationItem(page));
                }

                return items;
            }

            items.Add(new PaginationItem(1));

            int start;
            int end;

            if (currentPage <= 4)
            {
                start = 2;
                end = 4;
            }
            else if (currentPage >= totalPages - 3)
            {
                start = totalPages - 3;
                end = totalPages - 1;
            }
            else
            {
                start = currentPage - 1;
                end = currentPage + 1;
            }

            start = Math.Max(2, start);
            end = Math.Min(totalPages - 1, end);

            if (start > 2)
            {
                items.Add(PaginationItem.Ellipsis());
            }

            for (var page = start; page <= end; page++)
            {
                if (page > 1 && page < totalPages)
                {
                    items.Add(new PaginationItem(page));
                }
            }

            if (end < totalPages - 1)
            {
                items.Add(PaginationItem.Ellipsis());
            }

            items.Add(new PaginationItem(totalPages));

            return items;
        }
    }

    private void GoToPage(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > TotalPages || pageNumber == currentPage) return;
        currentPage = pageNumber;
        UpdatePagination();
    }

    private void PreviousPage()
    {
        if (!CanGoPrevious) return;
        currentPage--;
        UpdatePagination();
    }

    private void NextPage()
    {
        if (!CanGoNext) return;
        currentPage++;
        UpdatePagination();
    }

    private void GoToFirst()
    {
        if (!CanGoPrevious) return;
        currentPage = 1;
        UpdatePagination();
    }

    private void GoToLast()
    {
        if (!CanGoNext) return;
        currentPage = TotalPages;
        UpdatePagination();
    }

    private string GetPageButtonClass(int pageNumber)
    {
        return pageNumber == currentPage
            ? "pagination-link is-current"
            : "pagination-link";
    }

    private void HandlePageSizeChanged(int newSize)
    {
        if (newSize <= 0) return;
        if (pageSize == newSize) return;

        pageSize = newSize;
        currentPage = 1;
        UpdatePagination();
    }

    private void HandleGistPageSizeChanged(int newSize)
    {
        if (newSize <= 0) return;
        if (gistPageSize == newSize) return;

        gistPageSize = newSize;
        gistCurrentPage = 1;
        UpdateGistPagination();
    }

    private string? GetAriaCurrent(int pageNumber) => pageNumber == currentPage ? "page" : null;
    private string GetPageAriaLabel(int pageNumber) => pageNumber == currentPage ? $"Current page, page {pageNumber}" : $"Go to page {pageNumber}";

    // Gist Pagination Logic
    private void UpdateGistPagination()
    {
        if (filteredGists == null || filteredGists.Count == 0)
        {
            pagedGists = new List<Gist>();
            gistCurrentPage = 1;
            StateHasChanged();
            return;
        }

        var totalPages = GistTotalPages;
        if (totalPages == 0)
        {
            pagedGists = new List<Gist>();
            gistCurrentPage = 1;
            StateHasChanged();
            return;
        }

        if (gistCurrentPage > totalPages)
        {
            gistCurrentPage = totalPages;
        }

        if (gistCurrentPage < 1)
        {
            gistCurrentPage = 1;
        }

        var effectivePageSize = Math.Max(gistPageSize, 1);
        var skip = (gistCurrentPage - 1) * effectivePageSize;
        pagedGists = filteredGists.Skip(skip).Take(effectivePageSize).ToList();
        StateHasChanged();
    }

    private int GistTotalPages
    {
        get
        {
            if (filteredGists?.Count > 0)
            {
                var effectivePageSize = Math.Max(gistPageSize, 1);
                return (int)Math.Ceiling((double)filteredGists.Count / effectivePageSize);
            }
            return 0;
        }
    }

    private int GistFilteredCount => filteredGists?.Count ?? 0;
    private bool CanGoPreviousGist => gistCurrentPage > 1;
    private bool CanGoNextGist => gistCurrentPage < GistTotalPages;

    private IEnumerable<PaginationItem> GistPaginationItems
    {
        get
        {
            var totalPages = GistTotalPages;
            if (totalPages == 0)
            {
                return Enumerable.Empty<PaginationItem>();
            }

            var items = new List<PaginationItem>();

            if (totalPages <= 7)
            {
                for (var page = 1; page <= totalPages; page++)
                {
                    items.Add(new PaginationItem(page));
                }
                return items;
            }

            items.Add(new PaginationItem(1));

            int start;
            int end;

            if (gistCurrentPage <= 4)
            {
                start = 2;
                end = 4;
            }
            else if (gistCurrentPage >= totalPages - 3)
            {
                start = totalPages - 3;
                end = totalPages - 1;
            }
            else
            {
                start = gistCurrentPage - 1;
                end = gistCurrentPage + 1;
            }

            start = Math.Max(2, start);
            end = Math.Min(totalPages - 1, end);

            if (start > 2)
            {
                items.Add(PaginationItem.Ellipsis());
            }

            for (var page = start; page <= end; page++)
            {
                if (page > 1 && page < totalPages)
                {
                    items.Add(new PaginationItem(page));
                }
            }

            if (end < totalPages - 1)
            {
                items.Add(PaginationItem.Ellipsis());
            }

            items.Add(new PaginationItem(totalPages));

            return items;
        }
    }

    private void GoToGistPage(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > GistTotalPages || pageNumber == gistCurrentPage) return;
        gistCurrentPage = pageNumber;
        UpdateGistPagination();
    }

    private void PreviousGistPage()
    {
        if (!CanGoPreviousGist) return;
        gistCurrentPage--;
        UpdateGistPagination();
    }

    private void NextGistPage()
    {
        if (!CanGoNextGist) return;
        gistCurrentPage++;
        UpdateGistPagination();
    }

    private void GoToFirstGist()
    {
        if (!CanGoPreviousGist) return;
        gistCurrentPage = 1;
        UpdateGistPagination();
    }

    private void GoToLastGist()
    {
        if (!CanGoNextGist) return;
        gistCurrentPage = GistTotalPages;
        UpdateGistPagination();
    }

    private string GetGistPageButtonClass(int pageNumber)
    {
        return pageNumber == gistCurrentPage
            ? "pagination-link is-current"
            : "pagination-link";
    }

    private string? GetGistAriaCurrent(int pageNumber) => pageNumber == gistCurrentPage ? "page" : null;
    private string GetGistPageAriaLabel(int pageNumber) => pageNumber == gistCurrentPage ? $"Current page, page {pageNumber}" : $"Go to page {pageNumber}";

    private readonly record struct PaginationItem
    {
        public PaginationItem(int pageNumber, bool isEllipsis = false)
        {
            PageNumber = pageNumber;
            IsEllipsis = isEllipsis;
        }

        public bool IsPage => !IsEllipsis;
        public bool IsEllipsis { get; }
        public int PageNumber { get; }

        public static PaginationItem Ellipsis() => new(0, true);
    }
}
